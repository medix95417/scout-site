# Copy to .env and fill in. docker-compose reads this automatically.

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Leave at the "scoutsite" default for local development. On a VPS, set
# this to a real random value (openssl rand -base64 24) — the database
# port is bound to localhost only, but a real password is still cheap
# defense-in-depth once this is running on a public server. Any character
# openssl produces is fine here (including "/"): docker-compose.yml
# passes this straight through to the app as DB_PASSWORD, and
# internal/config builds the connection URL itself with proper escaping
# rather than splicing it into a "postgres://user:PASS@host" string by
# hand — the old approach broke the moment a generated password happened
# to contain "/".
POSTGRES_PASSWORD=scoutsite

# Leave COOKIE_DOMAIN empty for local development (localhost).
# Set to .47-yonkers.org in production so the session cookie is shared
# across both troop.47-yonkers.org and pack.47-yonkers.org (see
# scout-website-architecture-phase1.md Section 2).
COOKIE_DOMAIN=

# Used by the caddy service in production only.
TROOP_HOST=troop.47-yonkers.org
PACK_HOST=pack.47-yonkers.org

# Used only with `docker compose run app -bootstrap-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# SMTP settings for outbound email (password reset links + event reminder
# emails). Leave SMTP_HOST empty to run without email — the site still
# works fine; "forgot password" just quietly no-ops (a leader can reset a
# family's password from /admin/roster instead) and
# `-send-event-reminders` logs a warning and sends nothing.
#
# SMTP_PORT defaults to 587 (STARTTLS). For implicit TLS (typically port
# 465), set SMTP_TLS_MODE=tls. Most providers (e.g. a Google Workspace
# account, Mailgun, Postmark, SES SMTP) work with SMTP_PORT=587 and
# SMTP_TLS_MODE=starttls (the default) — just fill in the host/username/
# password/from they give you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Alternative to all of the SMTP_* settings above, for a host whose
# network blocks outbound SMTP entirely: sends mail over Fastmail's JMAP
# HTTPS API instead. Set MAIL_PROVIDER=fastmail-jmap and
# FASTMAIL_API_TOKEN (Fastmail -> Settings -> Privacy & Security ->
# Integrations -> API tokens, granted "Mail" access); SMTP_FROM above
# still applies (must be one of that Fastmail account's own
# addresses/aliases) but SMTP_HOST/PORT/USERNAME/TLS_MODE are ignored.
# Leave MAIL_PROVIDER empty to use SMTP as normal.
MAIL_PROVIDER=
FASTMAIL_API_TOKEN=

# How fast newsletters and prospect campaigns send, in messages per
# minute. Only the two bulk senders are paced — a password reset or an
# event reminder is never made to wait behind a batch.
#
# Two reasons to keep this modest. A provider counts one message per
# recipient and enforces a short-window limit as well as a daily one
# (Fastmail's ten-minute window is a quarter of the daily allowance), so
# a burst hits the short one first. And a hundred messages fired off in
# seconds looks like a spam burst to the RECEIVING side, which for a
# recruiting campaign costs it the whole point.
#
# Leave empty for the built-in default of 60/minute, which sends a
# hundred-family newsletter in under two minutes. Set a negative number
# to turn pacing off entirely.
MAIL_BULK_PER_MINUTE=

# How far ahead of an event's start time `-send-event-reminders` looks
# when deciding who to email (see README.md "Event reminder emails").
# Each RSVP'd member is only ever emailed once per event no matter how
# often the command runs.
REMINDER_WINDOW_HOURS=24

# File library / event photos (internal/storage) — S3-compatible object
# storage (self-hosted MinIO, AWS S3, Cloudflare R2, etc.). There is no
# bundled object-storage service in docker-compose.yml — point these at a
# bucket you already run/manage, and make sure the bucket itself exists
# (this app doesn't create it for you). Leave S3_ENDPOINT blank to run
# without file storage for now: the rest of the site works fine, and the
# file library/event photos just show a clear "not configured yet" notice
# instead of an error.
#
# S3_ENDPOINT accepts either a bare host (nyc3.digitaloceanspaces.com) or
# the full URL your provider's dashboard gives you, scheme included
# (https://nyc3.digitaloceanspaces.com) — either works, and a scheme, if
# present, overrides S3_USE_SSL.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=scoutsite-files
S3_USE_SSL=false

# Set to "true" only when a reverse proxy (the bundled Caddy, or your own)
# is the ONLY route to the app. It lets the app read a visitor's real
# address from X-Forwarded-For for rate limiting. Docker Compose sets this
# for you. Left unset, the header is ignored — if the app were reachable
# directly, a visitor could set it themselves and pick their own
# rate-limit bucket.
TRUST_PROXY_HEADERS=true
